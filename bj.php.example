<?php
declare(strict_types=1);
session_start();
header('X-Content-Type-Options: nosniff');
header('Referrer-Policy: no-referrer');
header("Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'");
header('Cache-Control: no-store, max-age=0');

const BJ_USER = 'airli';
const BJ_DEFAULT_PASSWORD = '123456789abc';
const CONFIG_FILE = __DIR__ . '/.moontv-config.enc';
const REMOTE_CONFIG_PHP = __DIR__ . '/config.php';

function h(string $value): string { return htmlspecialchars($value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8'); }
function csrf(): string { if (empty($_SESSION['csrf'])) $_SESSION['csrf'] = bin2hex(random_bytes(32)); return $_SESSION['csrf']; }
function valid_csrf(): bool { return isset($_POST['csrf'], $_SESSION['csrf']) && hash_equals($_SESSION['csrf'], (string)$_POST['csrf']); }
function logged_in(): bool { return !empty($_SESSION['bj_logged_in']); }
function rate_limited(): bool { $until=(int)($_SESSION['blocked_until']??0); return $until>time(); }
function load_encryption_key(): string {
    $source = @file_get_contents(REMOTE_CONFIG_PHP);
    if ($source === false || !preg_match("/const\\s+MOONTV_CONFIG_ENCRYPTION_KEY\\s*=\\s*'([^']+)'\\s*;/", $source, $m)) throw new RuntimeException('无法从 config.php 读取加密密钥');
    return $m[1];
}
function load_remote_token(): string {
    $source = @file_get_contents(REMOTE_CONFIG_PHP);
    if ($source === false || !preg_match("/const\s+MOONTV_REMOTE_CONFIG_TOKEN\s*=\s*'([^']+)'\s*;/", $source, $m)) throw new RuntimeException('无法从 config.php 读取访问 Token');
    return $m[1];
}
function push_remote_config(array $data): void {
    if (!function_exists('curl_init')) return;
    $scheme = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off') ? 'https' : 'http';
    $host = $_SERVER['HTTP_HOST'] ?? '';
    if ($host === '') return;
    $base = rtrim(str_replace('bj.php', '', $_SERVER['SCRIPT_NAME'] ?? '/mtv/'), '/');
    $url = $scheme . '://' . $host . $base . '/config.php';
    $ch = curl_init($url);
    curl_setopt_array($ch, [
        CURLOPT_POST => true,
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_TIMEOUT => 12,
        CURLOPT_HTTPHEADER => [
            'Authorization: Bearer ' . load_remote_token(),
            'Content-Type: application/json',
            'Accept: application/json',
        ],
        CURLOPT_POSTFIELDS => json_encode($data, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR),
    ]);
    $body = curl_exec($ch); $status = (int)curl_getinfo($ch, CURLINFO_RESPONSE_CODE); $err = curl_error($ch); curl_close($ch);
    if ($body === false || $status < 200 || $status >= 300) throw new RuntimeException('远程配置接口同步失败: ' . ($err ?: 'HTTP ' . $status));
}
function decrypt_config(string $payload, string $secret): array {
    $raw=base64_decode(trim($payload),true); if($raw===false||strlen($raw)<29) throw new RuntimeException('加密配置格式无效');
    $iv=substr($raw,0,12);$tag=substr($raw,12,16);$cipher=substr($raw,28);$key=hash('sha256',$secret,true);
    $plain=openssl_decrypt($cipher,'aes-256-gcm',$key,OPENSSL_RAW_DATA,$iv,$tag,'MoonTV-Remote-Config-v1');
    if($plain===false) throw new RuntimeException('配置解密失败');
    $data=json_decode($plain,true,512,JSON_THROW_ON_ERROR); if(!is_array($data)) throw new RuntimeException('配置内容无效'); return $data;
}
function encrypt_config(array $data,string $secret): string {
    $key=hash('sha256',$secret,true);$iv=random_bytes(12);$tag='';$plain=json_encode($data,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR);
    $cipher=openssl_encrypt($plain,'aes-256-gcm',$key,OPENSSL_RAW_DATA,$iv,$tag,'MoonTV-Remote-Config-v1',16); if($cipher===false) throw new RuntimeException('配置加密失败');
    return base64_encode($iv.$tag.$cipher);
}
function read_config(): array { if(!is_file(CONFIG_FILE)) return []; $raw=file_get_contents(CONFIG_FILE); if($raw===false) throw new RuntimeException('无法读取配置文件'); return decrypt_config($raw,load_encryption_key()); }
function write_config(array $data): void {
    $tmp=CONFIG_FILE.'.'.bin2hex(random_bytes(6)).'.tmp';$enc=encrypt_config($data,load_encryption_key());
    if(file_put_contents($tmp,$enc,LOCK_EX)===false) throw new RuntimeException('无法写入临时文件');@chmod($tmp,0600);
    if(!rename($tmp,CONFIG_FILE)){@unlink($tmp);throw new RuntimeException('无法保存配置文件');}
}

$error='';$notice='';
if(isset($_GET['logout'])){session_destroy();header('Location: bj.php');exit;}
if(!logged_in()&&$_SERVER['REQUEST_METHOD']==='POST'){
    if(rate_limited()){$error='尝试次数过多，请稍后再试';}
    elseif(!valid_csrf()){$error='请求校验失败';}
    else{
        $user=(string)($_POST['user']??'');$password=(string)($_POST['password']??'');
        $expected=getenv('MOONTV_BJ_PASSWORD')?:BJ_DEFAULT_PASSWORD;
        if(hash_equals(BJ_USER,$user)&&hash_equals($expected,$password)){session_regenerate_id(true);$_SESSION['bj_logged_in']=true;$_SESSION['attempts']=0;header('Location: bj.php');exit;}
        $_SESSION['attempts']=(int)($_SESSION['attempts']??0)+1;if($_SESSION['attempts']>=5){$_SESSION['blocked_until']=time()+900;$_SESSION['attempts']=0;}$error='账号或密码错误';
    }
}
$config=[];
if(logged_in()){
    try{$config=read_config();}catch(Throwable $e){$error=$e->getMessage();}
    if($_SERVER['REQUEST_METHOD']==='POST'&&isset($_POST['save'])){
        if(!valid_csrf()){$error='请求校验失败';}
        else{
            try{
                $json=(string)($_POST['json']??'');$decoded=json_decode($json,true,512,JSON_THROW_ON_ERROR);if(!is_array($decoded))throw new RuntimeException('JSON 必须是对象');
                write_config($decoded);push_remote_config($decoded);$config=$decoded;$notice='配置已加密保存并同步至远程接口。请在 MoonTV 管理面板点击“手动更新变量”，将配置复制到 Upstash、Redis 与 MySQL。';
            }catch(Throwable $e){$error=$e->getMessage();}
        }
    }
}
?><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>MoonTV 配置编辑</title><style>
body{font-family:system-ui,sans-serif;background:#0f172a;color:#e2e8f0;margin:0;padding:24px}.box{max-width:980px;margin:auto;background:#1e293b;padding:24px;border-radius:16px}input,textarea{width:100%;box-sizing:border-box;padding:12px;border-radius:8px;border:1px solid #475569;background:#0f172a;color:#fff;margin:8px 0 16px}textarea{min-height:65vh;font-family:ui-monospace,monospace}.btn{display:inline-block;border:0;border-radius:8px;padding:10px 16px;background:#16a34a;color:#fff;cursor:pointer}.logout{float:right;color:#93c5fd}.err{background:#7f1d1d;padding:10px;border-radius:8px}.ok{background:#14532d;padding:10px;border-radius:8px}.hint{color:#94a3b8;font-size:13px}</style></head><body><div class="box">
<?php if(!logged_in()): ?><h1>MoonTV 配置登录</h1><?php if($error): ?><p class="err"><?=h($error)?></p><?php endif; ?><form method="post"><input type="hidden" name="csrf" value="<?=h(csrf())?>"><label>账号</label><input name="user" autocomplete="username" required><label>密码</label><input type="password" name="password" autocomplete="current-password" required><button class="btn" type="submit">登录</button></form><p class="hint">默认账号 airli。首次登录后请尽快修改文件中的默认密码，或配置 MOONTV_BJ_PASSWORD。</p>
<?php else: ?><a class="logout" href="?logout=1">退出</a><h1>.moontv-config.enc 编辑器</h1><?php if($error): ?><p class="err"><?=h($error)?></p><?php endif; ?><?php if($notice): ?><p class="ok"><?=h($notice)?></p><?php endif; ?><form method="post"><input type="hidden" name="csrf" value="<?=h(csrf())?>"><textarea name="json" spellcheck="false"><?=h(json_encode($config,JSON_PRETTY_PRINT|JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES))?></textarea><button class="btn" type="submit" name="save" value="1">验证、加密并保存</button></form><p class="hint">保存前会验证 JSON。配置仍以 AES-256-GCM 密文写入，不会保存为明文。不要公开此页面。</p><?php endif; ?></div></body></html>
